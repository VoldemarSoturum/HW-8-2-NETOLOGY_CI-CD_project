server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Статические файлы - FIXED
    location /static/ {
        alias /home/voldemar-soturum/HW7-6_DJANGO-CRUD_in_DRF/EX1+ADDIONS-Stocks_products/staticfiles/;
    }

    # Медиа файлы (на будущее)
    location /media/ {
        alias /home/voldemar-soturum/HW7-6_DJANGO-CRUD_in_DRF/EX1+ADDIONS-Stocks_products/media/;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Основное приложение Django
    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://unix:/home/voldemar-soturum/HW7-6_DJANGO-CRUD_in_DRF/EX1+ADDIONS-Stocks_products/stocks_products.sock;
    }

    # Запрещаем доступ к скрытым файлам
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Запрещаем доступ к файлам логов
    location ~* \.(log|txt)$ {
        deny all;
    }
}
